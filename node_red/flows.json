    {
        "id": "abc23a676639322d",
        "type": "function",
        "z": "8968eeb8b116fa7f",
        "g": "4a64feae98d0c5fb",
        "name": "pulse True then False",
        "func": "// startCmd/stopCmd/resetCmd are read by the ladder as momentary\n// commands, not latched switches. We send True immediately, then\n// schedule a False write ~300ms later so the coil doesn't stay\n// stuck On -- this keeps Node-RED's button behaving like a real\n// momentary pushbutton on a control panel, regardless of whether\n// the ladder itself does edge detection.\nfunction buildWriteMsg(value) {\n    return {\n        payload: {\n            value: value,\n            fc: 5,\n            unitid: 1,\n            address: 3,\n            quantity: 1\n        }\n    };\n}\n\nvar onMsg = buildWriteMsg(true);\nvar offMsg = buildWriteMsg(false);\n\nsetTimeout(function () {\n    node.send(offMsg);\n}, 300);\n\nreturn onMsg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 560,
        "y": 560,
        "wires": [
            [
                "6c54f602fdee0620"
            ]
        ]
    },
