        "func": "function buildWriteMsg(value) {\n    return {\n        payload: {\n            value: value,\n            fc: 5,\n            unitid: 1,\n            address: 4,\n            quantity: 1\n        }\n    };\n}\n\nvar onMsg = buildWriteMsg(true);\nvar offMsg = buildWriteMsg(false);\n\nsetTimeout(function () {\n    node.send(offMsg);\n}, 300);\n\nreturn onMsg;",
