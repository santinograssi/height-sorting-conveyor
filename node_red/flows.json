    {
        "id": "69e365d91d50f257",
        "type": "function",
        "z": "8968eeb8b116fa7f",
        "g": "c2169d089ac639e1",
        "name": "show banner only if alarm active",
        "func": "// The Reset Alarm banner/button group is only meaningful while\n// alarmActive is True. We drive the group's visibility from here\n// so the operator isn't tempted to click Reset when there's nothing\n// to reset -- mirrors the ladder's own alarm-priority pattern: the\n// alarm state is the single source of truth for what's relevant.\nvar alarmIsActive = msg.payload === true;\n\nmsg.payload = {\n    group: {\n        show: alarmIsActive ? [\"grp_alarm_banner\"] : [],\n        hide: alarmIsActive ? [] : [\"grp_alarm_banner\"]\n    }\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1010,
        "y": 380,
